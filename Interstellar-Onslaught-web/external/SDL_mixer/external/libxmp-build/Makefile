	cd /Users/edgaralamillo/Downloads/Prorgams/Personal/Interstellar-Onslaught/build-web && $(MAKE) $(MAKESILENT) -f external/SDL_mixer/external/libxmp-build/CMakeFiles/xmp_static.dir/build.make external/SDL_mixer/external/libxmp-build/CMakeFiles/xmp_static.dir/src/win32.c.o
.PHONY : src/win32.c.o

src/win32.i: src/win32.c.i
.PHONY : src/win32.i

# target to preprocess a source file
