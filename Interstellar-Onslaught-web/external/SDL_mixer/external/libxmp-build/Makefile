	cd /Users/edgaralamillo/Downloads/Prorgams/Personal/Interstellar-Onslaught/build-web && $(MAKE) $(MAKESILENT) -f external/SDL_mixer/external/libxmp-build/CMakeFiles/xmp_static.dir/build.make external/SDL_mixer/external/libxmp-build/CMakeFiles/xmp_static.dir/src/win32.c.i
.PHONY : src/win32.c.i

src/win32.s: src/win32.c.s
.PHONY : src/win32.s

